# Application
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://pricehub:pricehub@localhost:5432/pricehub?schema=public"

# Aggregation
FETCH_INTERVAL_MS=30000
STALE_THRESHOLD_MS=120000

# Provider URLs (self-hosted simulated APIs)
PROVIDER_A_URL=http://localhost:3000/providers/a/products
PROVIDER_B_URL=http://localhost:3000/providers/b/products
PROVIDER_C_URL=http://localhost:3000/providers/c/products

# Retry
MAX_RETRIES=3
RETRY_DELAY_MS=1000

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
